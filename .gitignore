# Залежності
node_modules/
.pnp
.pnp.js

# Збірка
dist/
# build/ — електрон-білдерівський buildResources, тека ВХІДНИХ ресурсів
# (не згенерованого виводу — колізія імені з типовим "build output" тут
# оманлива). icon.ico потрібен CI й будь-кому, хто клонує репозиторій —
# без нього electron-builder мовчки підставляє типову піктограму Electron
# (2026-08-03, розділ 7.9 STATE.md). `build/` (з косою рискою) виключив би
# ВЕСЬ каталог і не дав би git навіть зайти всередину для винятку нижче —
# тому `build/*`, а не `build/`.
build/*
!build/icon.ico
out/
release/
*.tsbuildinfo

# Electron
.electron-gyp/
app.asar

# Спайки
spikes/**/out/

